APP_NAME="Leen Handbags"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# DB_HOST=mysql
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=sail
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="info@leen.com.co"
MAIL_FROM_NAME="${APP_NAME}"

# Drivers de correo transaccional alternativos (config/services.php)
# RESEND_API_KEY=
# POSTMARK_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Context7 MCP
CONTEXT7_API_KEY=

# Catálogo y Configuración de Moneda (F01)
# Comma-separated emails provisioned with the Spatie 'admin' role during db:seed.
ADMIN_EMAILS=admin@admin.com
ECOMMERCE_DEFAULT_CURRENCY=COP

# Moneda y Localización Geográfica (F14 & F13)
ECOMMERCE_CURRENCY_COOKIE=currency
ECOMMERCE_CURRENCY_COOKIE_LIFETIME=525600
ECOMMERCE_COUNTRY_HEADER=CF-IPCountry
ECOMMERCE_LOCALE_COOKIE=locale
ECOMMERCE_LOCALE_COOKIE_LIFETIME=525600
# ECOMMERCE_TRUSTED_PROXIES=

# Costos de Envío Estándar (F04)
ECOMMERCE_SHIPPING_STANDARD_COST_COP=0
ECOMMERCE_SHIPPING_STANDARD_COST_EUR=0
ECOMMERCE_SHIPPING_STANDARD_COST_USD=0

# Pasarelas de Pago (F05)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_API_BASE=https://api.stripe.com

BOLD_API_KEY=
BOLD_SECRET_KEY=
BOLD_WEBHOOK_SECRET=
# BOLD_API_BASE=https://integrations.api.bold.co

# Información de Contacto y Redes Sociales
CONTACT_MAIL_TO=contacto@leen.example
CONTACT_PUBLIC_EMAIL=contacto@leen.example
CONTACT_PHONE="+57 300 123 4567"
CONTACT_PHONE_RAW="+573001234567"
CONTACT_WHATSAPP="+57 300 123 4567"
CONTACT_WHATSAPP_URL="https://wa.me/573001234567"
SOCIAL_INSTAGRAM_URL="https://www.instagram.com/leen_____________________/"
SOCIAL_TIKTOK_URL="https://www.tiktok.com/@leenhandbags"

# Descuento por Umbral de Carrito (F17)
ECOMMERCE_THRESHOLD_DISCOUNT_ENABLED=true
ECOMMERCE_THRESHOLD_DISCOUNT_PERCENTAGE=10
ECOMMERCE_THRESHOLD_MIN_COP=1200000
ECOMMERCE_THRESHOLD_MIN_EUR=30000
ECOMMERCE_THRESHOLD_MIN_USD=32000

# Alertas Automáticas de Wishlist (F18)
ECOMMERCE_WISHLIST_ALERTS_ENABLED=true
ECOMMERCE_WISHLIST_LOW_STOCK_THRESHOLD=3
ECOMMERCE_WISHLIST_COOLDOWN_DAYS=7
ECOMMERCE_WISHLIST_MAX_ALERTS_PER_USER=3

# Túnel HTTPS local para Webhooks
NGROK_AUTHTOKEN=
NGROK_URL=
# FORWARD_NGROK_PORT=4040
# COMPOSE_PROFILES=ngrok
